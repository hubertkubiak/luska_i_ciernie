{
  "name": "luska-i-ciernie",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "db:seed": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/seed.ts",
    "prestart": "npm run db:seed",
    "start": "ng serve",
    "start:en": "ng serve --configuration=en",
    "prebuild": "npm run db:seed",
    "build": "ng build",
    "build:i18n": "ng build --localize",
    "prebuild:i18n": "npm run db:seed",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:luska-i-ciernie": "node dist/luska-i-ciernie/server/server.mjs",
    "e2e": "ng e2e",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run"
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-server": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/ssr": "^22.2.4",
    "@fontsource/cinzel-decorative": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.0",
    "@angular/localize": "^22.2.3",
    "@cypress/schematic": "^6.0.0",
    "@types/express": "^5.0.1",
    "@types/node": "^22.12.0",
    "cypress": "16.2.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
