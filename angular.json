{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "schematicCollections": ["@cypress/schematic", "@schematics/angular"]
  },
  "newProjectRoot": "projects",
  "projects": {
    "luska-i-ciernie": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "i18n": {
        "sourceLocale": {
          "code": "pl",
          "subPath": ""
        },
        "locales": {
          "en": {
            "translation": "src/locale/messages.en.json",
            "subPath": "en"
          }
        }
      },
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "node_modules/@fontsource/cinzel-decorative/latin-700.css",
              "node_modules/@fontsource/cinzel-decorative/latin-ext-700.css",
              "node_modules/@fontsource/cormorant-garamond/latin-600.css",
              "node_modules/@fontsource/cormorant-garamond/latin-700.css",
              "node_modules/@fontsource/cormorant-garamond/latin-ext-600.css",
              "node_modules/@fontsource/cormorant-garamond/latin-ext-700.css",
              "node_modules/@fontsource/eb-garamond/latin-400.css",
              "node_modules/@fontsource/eb-garamond/latin-400-italic.css",
              "node_modules/@fontsource/eb-garamond/latin-ext-400.css",
              "node_modules/@fontsource/eb-garamond/latin-ext-400-italic.css",
              "node_modules/@fontsource/inter/latin-400.css",
              "node_modules/@fontsource/inter/latin-500.css",
              "node_modules/@fontsource/inter/latin-600.css",
              "node_modules/@fontsource/inter/latin-ext-400.css",
              "node_modules/@fontsource/inter/latin-ext-500.css",
              "node_modules/@fontsource/inter/latin-ext-600.css",
              "src/styles.scss"
            ],
            "server": "src/main.server.ts",
            "outputMode": "server",
            "security": {
              "allowedHosts": ["localhost"]
            },
            "ssr": {
              "entry": "src/server.ts"
            },
            "polyfills": ["@angular/localize/init"],
            "externalDependencies": ["node:sqlite"]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "en": {
              "localize": ["en"]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "luska-i-ciernie:build:production"
            },
            "development": {
              "buildTarget": "luska-i-ciernie:build:development"
            },
            "en": {
              "buildTarget": "luska-i-ciernie:build:development,en"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        },
        "cypress-run": {
          "builder": "@cypress/schematic:cypress",
          "options": {
            "devServerTarget": "luska-i-ciernie:serve"
          },
          "configurations": {
            "production": {
              "devServerTarget": "luska-i-ciernie:serve:production"
            }
          }
        },
        "cypress-open": {
          "builder": "@cypress/schematic:cypress",
          "options": {
            "watch": true,
            "headless": false
          }
        },
        "ct": {
          "builder": "@cypress/schematic:cypress",
          "options": {
            "devServerTarget": "luska-i-ciernie:serve",
            "watch": true,
            "headless": false,
            "testingType": "component"
          },
          "configurations": {
            "development": {
              "devServerTarget": "luska-i-ciernie:serve:development"
            }
          }
        },
        "e2e": {
          "builder": "@cypress/schematic:cypress",
          "options": {
            "devServerTarget": "luska-i-ciernie:serve",
            "watch": true,
            "headless": false
          },
          "configurations": {
            "production": {
              "devServerTarget": "luska-i-ciernie:serve:production"
            }
          }
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n",
          "options": {
            "buildTarget": "luska-i-ciernie:build",
            "format": "json",
            "outputPath": "src/locale"
          }
        }
      }
    }
  }
}
